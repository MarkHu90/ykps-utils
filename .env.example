# Azure Translator credentials
AZURE_TRANSLATOR_KEY=replace-with-your-azure-translator-key
# Required for regional or multi-service resources; optional for a global Translator resource.
# AZURE_TRANSLATOR_REGION=eastasia
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# Optional Translator V3 Custom Translator category ID. Omit it to use the general system.
# AZURE_TRANSLATOR_CATEGORY=

# Optional Aliyun Direct Mail SMTP credentials. Both values are required to enable email.
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=25
SMTP_SECURE=false
# Optional UTF-8 JSON template catalog. Relative paths resolve from the process working directory.
# EMAIL_TEMPLATES_FILE=./config/email-templates.json

# Optional notification channels and event routing catalog.
# NOTIFICATION_CONFIG_FILE=./config/notification-config.json

# Inbound HTTP authentication. Use one or more comma-separated values (minimum 16 characters each).
SERVICE_API_KEYS=replace-with-a-long-random-client-key

HOST=127.0.0.1
PORT=3030
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# ALLOWED_ORIGINS=localhost